{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@common/*": ["src/common/*"],
      "@config/*": ["src/config/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@core/*": ["src/core/*"],
      "@modules/*": ["src/modules/*"]
    },
    "types": ["node", "jest"],
    "module": "NodeNext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["./src/**/*.ts", "./test/**/*.test.ts"]
}
