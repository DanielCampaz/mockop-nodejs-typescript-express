{
  "name": "api-stream-flow",
  "type": "module",
  "version": "1.0.0",
  "main": "dist/root.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "scripts": {
    "execute": "yarn typecheck && yarn test && yarn build && yarn start",
    "start": "node dist/root.js",
    "start:dev": "tsx watch src/root.ts",
    "typecheck": "tsc --noEmit",
    "build": "yarn typecheck && yarn build:tsup && yarn build:obfuscate",
    "build:tsup": "tsup",
    "build:obfuscate": "javascript-obfuscator dist --output dist --config obfuscator.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.33",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.4.2",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  }
}
